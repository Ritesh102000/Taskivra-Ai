{
  "manifest_version": 3,
  "name": "Agent Workspaces Browser Bridge",
  "version": "0.1.0",
  "description": "Scoped background browser commands for dedicated Agent Workspaces Chrome profiles.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Workspaces — dedicated profile bridge",
    "default_popup": "status.html"
  }
}
